{
  "_source": "LCBT course finder logic v1.xlsx - sheet 'logic', rows 18-72, reconciled against the live catalogue at lcbt.co.uk/courses (7 Sept 2026). The sheet's hidden rows 11-13 define separate '19+ Level 3' courses that do not exist on the live site: there is one Level 3 diploma per subject, open to both age groups with different funding. The 19+ rules below therefore resolve to l3-* rather than to separate 19+ course records. Rules are evaluated top to bottom; the first whose `when` clause matches wins. Decks are no longer topped up with a 'see all' card: client feedback (LCBT Quiz Feedback, 9 Sept 2026) was that browsing all courses should not be a swipeable card. The route out now sits on the results panel instead.",
  "rules": [
    {
      "id": "16-18-no-prior",
      "note": "Sheet rows 18-27: 16-18, no previous qualification -> recommend Level 2.",
      "when": {
        "age": "16-18",
        "priorLevel": [
          "none",
          "notsure"
        ]
      },
      "results": {
        "beauty": [
          "l2-beauty",
          "l2-mua"
        ],
        "hair": [
          "l2-hair",
          "l2-mua",
          "l2-beauty"
        ],
        "makeup": [
          "l2-mua",
          "l2-beauty",
          "l2-hair"
        ],
        "all": [
          "l2-mua",
          "l2-beauty",
          "l2-hair"
        ]
      }
    },
    {
      "id": "16-18-level2",
      "note": "Sheet rows 29-36: 16-18 holding a Level 2 -> recommend Level 3. Not reachable while the prior-qualification question is 19+ only (see questions.json).",
      "when": {
        "age": "16-18",
        "priorLevel": [
          "Level 2",
          "Level 3"
        ]
      },
      "results": {
        "beauty": [
          "l3-beauty"
        ],
        "hair": [
          "l3-hair"
        ],
        "makeup": [
          "l3-mua"
        ],
        "all": [
          "l3-mua",
          "l3-beauty",
          "l3-hair"
        ]
      }
    },
    {
      "id": "19-plus-no-prior-short-courses",
      "note": "Sheet rows 39-46: 19+, no previous qualification -> short courses if available.",
      "when": {
        "age": "19+",
        "priorLevel": "none",
        "shortCoursesAvailable": true
      },
      "results": {
        "beauty": [
          "short-courses",
          "register-interest"
        ],
        "hair": [
          "short-courses",
          "register-interest"
        ],
        "makeup": [
          "short-courses",
          "register-interest"
        ],
        "all": [
